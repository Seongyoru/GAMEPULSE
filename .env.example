# GAMEPULSE environment. Copy to `.env` (never commit `.env`).
# Every variable is optional for development: without DATABASE_URL the web app serves
# synthetic fixtures from memory, and no external API key is ever required.

NODE_ENV=development
LOG_LEVEL=info
# json | pretty (defaults: pretty in development, json in production)
LOG_FORMAT=

# ── Infrastructure ───────────────────────────────────────────────────────────
# `docker compose up -d` or `pnpm services:local` provide these:
DATABASE_URL=postgres://gamepulse:gamepulse@localhost:5432/gamepulse
REDIS_URL=redis://localhost:6379
# Integration tests create throwaway databases here; unset = embedded PGlite.
TEST_DATABASE_URL=

# ── Web ──────────────────────────────────────────────────────────────────────
# fixtures | database   (default: database when DATABASE_URL is set, otherwise fixtures)
GAMEPULSE_DATA_SOURCE=
# Public base URL for canonical links and sitemaps. No production domain is hardcoded.
GAMEPULSE_SITE_URL=http://localhost:3000
# Synthetic fixtures are refused in production unless explicitly allowed (staging previews).
GAMEPULSE_ALLOW_FIXTURES_IN_PRODUCTION=false
# Fixed anchor (ISO) for relative fixture dates; default = the current hour.
FIXTURE_ANCHOR=
# ISR regeneration interval for public pages (seconds).
REVALIDATE_SECONDS=300
# Client-side analytics: none | console | ga4  (GA4 is never required)
NEXT_PUBLIC_ANALYTICS_PROVIDER=none
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# Advertising placements: off | placeholder  (no ad provider is integrated)
NEXT_PUBLIC_ADS_MODE=off

# ── Collectors ───────────────────────────────────────────────────────────────
# fixture | mock | live
COLLECTOR_MODE=fixture
COLLECTOR_USER_AGENT=GAMEPULSE-Collector/0.1
# Contact URL or e-mail included in the User-Agent so site operators can reach us.
COLLECTOR_CONTACT=
INGEST_SCHEDULE_ENABLED=true
RAW_TEXT_RETENTION_DAYS=30
# In this sandbox Node's fetch only uses the HTTPS proxy with this flag (Node >= 22.21):
# NODE_USE_ENV_PROXY=1

# ── Official API credentials (server-side only; never exposed to the browser) ─
# Riot Games developer key (development keys expire every 24h; public products need a production key)
RIOT_API_KEY=
# Lost Ark Open API JWT (developer-lostark.game.onstove.com)
LOSTARK_API_KEY=
# NEXON Open API key (openapi.nexon.com)
NEXON_OPEN_API_KEY=

# ── AI parsing (optional) ────────────────────────────────────────────────────
# mock | rule-based | claude   — tests always use the mock parser
AI_PARSER=rule-based
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5-5

# ── Error monitoring (optional) ──────────────────────────────────────────────
SENTRY_DSN=
